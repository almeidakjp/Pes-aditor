package com.peseditor;

import android.app.Activity;
import android.os.Bundle;
import android.graphics.Color;
import android.view.Gravity;
import android.widget.Button;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;

public class RenomearActivity extends Activity {

    private android.net.Uri pastaUri;
    private TextView txtStatus;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        LinearLayout layout = new LinearLayout(this);
        layout.setOrientation(LinearLayout.VERTICAL);
        layout.setGravity(Gravity.CENTER_HORIZONTAL);
        layout.setPadding(24, 24, 24, 24);

        TextView titulo = new TextView(this);
        titulo.setText("🔤 RENOMEAR");
        titulo.setTextSize(28);
        titulo.setTextColor(Color.BLACK);
        titulo.setGravity(Gravity.CENTER);
        titulo.setPadding(0, 0, 0, 25);
        layout.addView(titulo);

        TextView explicacao = new TextView(this);
        explicacao.setText(
                "Renomeia os PNGs usando OCR.\n\n" +
                "O código original do arquivo é usado para gerar o #Resultados.txt."
        );
        explicacao.setTextSize(16);
        layout.addView(explicacao);

        Button btnPasta = new Button(this);
        btnPasta.setText("📁 SELECIONAR PASTA DOS PNGs");
        btnPasta.setTextSize(17);
        layout.addView(btnPasta);

        Button btnProcessar = new Button(this);
        btnProcessar.setText("▶️ PROCESSAR RENOMEAR");
        btnProcessar.setTextSize(17);
        layout.addView(btnProcessar);

        txtStatus = new TextView(this);
        txtStatus.setText("\nNenhuma pasta selecionada.");
        txtStatus.setTextSize(15);
        layout.addView(txtStatus);

        ScrollView scroll = new ScrollView(this);
        scroll.addView(layout);
        setContentView(scroll);

        btnPasta.setOnClickListener(v -> selecionarPasta());

        btnProcessar.setOnClickListener(v -> {

            if (pastaUri == null) {

                android.widget.Toast.makeText(
                        this,
                        "Selecione a pasta dos PNGs primeiro.",
                        android.widget.Toast.LENGTH_SHORT
                ).show();

                return;
            }

            new Thread(() -> {

                try {

                    java.util.List<android.net.Uri> arquivos =
                            listarPngs();

                    if (arquivos.isEmpty()) {

                        runOnUiThread(() ->
                                txtStatus.setText(
                                        "⚠️ Nenhum PNG encontrado."
                                )
                        );

                        return;
                    }

                    StringBuilder resultado =
                            new StringBuilder();

                    resultado.append(
                            "⏳ PROCESSANDO OCR...\n\n"
                    );

                    int numero = 0;

                    for (android.net.Uri arquivo : arquivos) {

                        numero++;

                        String nomeArquivo =
                                obterNome(arquivo);

                        final int atual = numero;
                        final String nomeAtual =
                                nomeArquivo;

                        runOnUiThread(() ->
                                txtStatus.setText(
                                        "⏳ Processando OCR...\n\n" +
                                        "Arquivo: " +
                                        atual +
                                        " / " +
                                        arquivos.size() +
                                        "\n\n" +
                                        nomeAtual
                                )
                        );

                        java.io.InputStream in =
                                getContentResolver()
                                        .openInputStream(arquivo);

                        if (in == null) {

                            resultado.append(
                                    nomeArquivo +
                                    "\n   ❌ Não foi possível abrir\n\n"
                            );

                            continue;
                        }

                        java.io.ByteArrayOutputStream baos =
                                new java.io.ByteArrayOutputStream();

                        byte[] buffer = new byte[8192];
                        int n;

                        while ((n = in.read(buffer)) != -1) {
                            baos.write(buffer, 0, n);
                        }

                        in.close();

                        String nomeLido;

                        try {

                            nomeLido =
                                    executarOCR(
                                            baos.toByteArray()
                                    );

                        } catch (Exception erroOCR) {

                            nomeLido = "";
                        }

                        String codigo =
                                extrairCodigo(nomeArquivo);

                        resultado.append(
                                nomeArquivo +
                                "\n   Código: " +
                                (codigo.isEmpty()
                                        ? "[não encontrado]"
                                        : codigo) +
                                "\n   Nome lido: " +
                                (nomeLido.isEmpty()
                                        ? "[ERRO OCR]"
                                        : nomeLido) +
                                "\n\n"
                        );
                    }

                    final String textoFinal =
                            resultado.toString();

                    runOnUiThread(() ->
                            txtStatus.setText(textoFinal)
                    );

                } catch (Exception e) {

                    final String erro =
                            e.getMessage() == null
                                    ? e.toString()
                                    : e.getMessage();

                    runOnUiThread(() ->
                            txtStatus.setText(
                                    "❌ ERRO:\n\n" +
                                    erro
                            )
                    );
                }

            }).start();
        });
    }

    private java.util.List<android.net.Uri> listarPngs() {

        java.util.List<android.net.Uri> arquivos =
                new java.util.ArrayList<>();

        if (pastaUri == null) {
            return arquivos;
        }

        String documentId =
                android.provider.DocumentsContract
                        .getTreeDocumentId(pastaUri);

        android.net.Uri childrenUri =
                android.provider.DocumentsContract
                        .buildChildDocumentsUriUsingTree(
                                pastaUri,
                                documentId
                        );

        android.database.Cursor cursor =
                getContentResolver().query(
                        childrenUri,
                        new String[]{
                                android.provider.DocumentsContract.Document
                                        .COLUMN_DOCUMENT_ID,
                                android.provider.DocumentsContract.Document
                                        .COLUMN_DISPLAY_NAME
                        },
                        null,
                        null,
                        null
                );

        if (cursor == null) {
            return arquivos;
        }

        try {

            while (cursor.moveToNext()) {

                String id = cursor.getString(0);
                String nome = cursor.getString(1);

                if (nome == null) {
                    continue;
                }

                if (!nome.toLowerCase().endsWith(".png")) {
                    continue;
                }

                android.net.Uri arquivo =
                        android.provider.DocumentsContract
                                .buildDocumentUriUsingTree(
                                        pastaUri,
                                        id
                                );

                arquivos.add(arquivo);
            }

        } finally {
            cursor.close();
        }

        return arquivos;
    }

    private String obterNome(android.net.Uri uri) {

        android.database.Cursor cursor =
                getContentResolver().query(
                        uri,
                        new String[]{
                                android.provider.DocumentsContract.Document
                                        .COLUMN_DISPLAY_NAME
                        },
                        null,
                        null,
                        null
                );

        if (cursor != null) {

            try {

                if (cursor.moveToFirst()) {
                    return cursor.getString(0);
                }

            } finally {
                cursor.close();
            }
        }

        return "arquivo.png";
    }

    private String limparNome(String texto) {

        if (texto == null) {
            return "";
        }

        texto = texto.trim();
        texto = texto.replaceAll("\\s+", " ");

        texto = texto.replace("G, ", "G. ");
        texto = texto.replace("J, ", "J. ");
        texto = texto.replace("T, ", "T. ");

        texto = texto.replaceAll("[/\\\\:*?\"<>|]", "-");

        return texto.trim();
    }

    private String extrairCodigo(String nome) {

        if (nome == null) {
            return "";
        }

        int ponto = nome.lastIndexOf('.');

        String base;

        if (ponto > 0) {
            base = nome.substring(0, ponto);
        } else {
            base = nome;
        }

        if (base.length() < 8) {
            return "";
        }

        return base.substring(base.length() - 8);
    }

    private String executarOCR(byte[] dados) throws Exception {

        java.io.File original =
                new java.io.File(getCacheDir(), "ocr_original.png");

        java.io.File preparado =
                new java.io.File(getCacheDir(), "ocr_preparado.png");

        java.io.File saida =
                new java.io.File(getCacheDir(), "ocr_saida");

        java.io.FileOutputStream fos =
                new java.io.FileOutputStream(original);

        fos.write(dados);
        fos.flush();
        fos.close();

        android.graphics.Bitmap bitmap =
                android.graphics.BitmapFactory.decodeByteArray(
                        dados,
                        0,
                        dados.length
                );

        if (bitmap == null) {
            return "";
        }

        bitmap = bitmap.copy(
                android.graphics.Bitmap.Config.ARGB_8888,
                false
        );

        int largura = bitmap.getWidth();
        int altura = bitmap.getHeight();

        android.graphics.Bitmap preparadoBitmap =
                android.graphics.Bitmap.createScaledBitmap(
                        bitmap,
                        largura * 10,
                        altura * 10,
                        true
                );

        android.graphics.Canvas canvas =
                new android.graphics.Canvas(preparadoBitmap);

        android.graphics.Paint paint =
                new android.graphics.Paint(
                        android.graphics.Paint.ANTI_ALIAS_FLAG
                );

        canvas.drawBitmap(
                preparadoBitmap,
                0,
                0,
                paint
        );

        java.io.FileOutputStream fos2 =
                new java.io.FileOutputStream(preparado);

        preparadoBitmap.compress(
                android.graphics.Bitmap.CompressFormat.PNG,
                100,
                fos2
        );

        fos2.flush();
        fos2.close();

        bitmap.recycle();

        try {

            Process processo = new ProcessBuilder(
                    "tesseract",
                    preparado.getAbsolutePath(),
                    saida.getAbsolutePath(),
                    "--psm",
                    "7",
                    "-l",
                    "eng"
            )
                    .redirectErrorStream(true)
                    .start();

            java.io.BufferedReader leitor =
                    new java.io.BufferedReader(
                            new java.io.InputStreamReader(
                                    processo.getInputStream()
                            )
                    );

            StringBuilder log =
                    new StringBuilder();

            String linha;

            while ((linha = leitor.readLine()) != null) {
                log.append(linha).append("\n");
            }

            int codigoSaida = processo.waitFor();

            if (codigoSaida != 0) {
                return "";
            }

            java.io.File txt =
                    new java.io.File(
                            saida.getAbsolutePath() + ".txt"
                    );

            if (!txt.exists()) {
                return "";
            }

            String texto =
                    new String(
                            java.nio.file.Files.readAllBytes(
                                    txt.toPath()
                            ),
                            java.nio.charset.StandardCharsets.UTF_8
                    );

            return limparNome(texto);

        } finally {

            original.delete();
            preparado.delete();

            java.io.File txt =
                    new java.io.File(
                            saida.getAbsolutePath() + ".txt"
                    );

            txt.delete();
        }
    }

    private void selecionarPasta() {
        android.content.Intent intent =
                new android.content.Intent(
                        android.content.Intent.ACTION_OPEN_DOCUMENT_TREE
                );

        intent.addFlags(
                android.content.Intent.FLAG_GRANT_READ_URI_PERMISSION |
                android.content.Intent.FLAG_GRANT_WRITE_URI_PERMISSION |
                android.content.Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION
        );

        startActivityForResult(intent, 701);
    }

    @Override
    protected void onActivityResult(
            int requestCode,
            int resultCode,
            android.content.Intent data
    ) {
        super.onActivityResult(requestCode, resultCode, data);

        if (requestCode == 701 &&
                resultCode == RESULT_OK &&
                data != null &&
                data.getData() != null) {

            pastaUri = data.getData();

            try {
                getContentResolver().takePersistableUriPermission(
                        pastaUri,
                        android.content.Intent.FLAG_GRANT_READ_URI_PERMISSION |
                        android.content.Intent.FLAG_GRANT_WRITE_URI_PERMISSION
                );
            } catch (Exception ignored) {
            }

            txtStatus.setText(
                    "📁 Pasta dos PNGs selecionada."
            );
        }
    }
}
